# =================================================================
# RouteGuard AI - Environment Configuration Template
# =================================================================

# Core Threshold Defaults (Configurable Policy)
HISTORY_THRESHOLD_PCT=15.0
PEER_THRESHOLD_PCT=15.0
TRAILING_HISTORY_WEEKS=8

# Retrieval and Embedding Settings
# Defaults to open-source local sentence-transformers (Zero API Cost)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional Language Model Provider for Assistant Enhancements
# Allowed options: 'none' (default offline grounded reasoning), 'openai', 'ollama'
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
